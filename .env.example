# Copy names (NOT values) into Vercel → Project → Settings → Environment Variables.
# For local development: copy this file to .env.local (git-ignored) and fill in values.
# NEXT_PUBLIC_ values are visible to every visitor. Never put a secret in one.

# Your site's public URL (used for email links and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # safe for the browser; RLS protects data
SUPABASE_SECRET_KEY=                    # 🔒 SECRET. Bypasses RLS. Server only.

# Stripe → Developers → API keys (use TEST keys until launch)
STRIPE_SECRET_KEY=                      # 🔒 SECRET
STRIPE_WEBHOOK_SECRET=                  # 🔒 SECRET (from the webhook endpoint)
STRIPE_PRICE_ID=                        # price_... for your Pro plan

# Resend → API Keys
RESEND_API_KEY=                         # 🔒 SECRET
EMAIL_FROM=Your Business <hello@yourdomain.com>
